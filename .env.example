# ============================================================
# Variables de entorno — Reclamos CABA
# Copiar a .env.local (desarrollo) y cargar en el hosting (producción).
# NUNCA commitear .env.local (está en .gitignore).
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# SOLO server. Bypassa RLS. Cargar como variable NO pública en el hosting.
# Nunca exponer al cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Gate del dashboard público (/public/*) ---
# A propósito NO llevan prefijo NEXT_PUBLIC: se validan server-side
# (src/app/api/public/login/route.ts) y nunca llegan al bundle del navegador.
# Usá valores fuertes en producción (no MASTER / 123456).
MASTER_USER=<usuario-master>
MASTER_PASS=<contraseña-fuerte>

# Secreto para firmar la cookie de sesión del gate público (HMAC-SHA256).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotarlo invalida todas las sesiones activas del dashboard público.
PUBLIC_SESSION_SECRET=<64-hex-random>

# Cuentas adicionales de /public con acceso restringido (ven solo algunas
# pestañas — ver src/lib/publicAccounts.ts). Formato: usuario:contraseña:rol,...
# Roles disponibles hoy: "reclamos" (solo la pestaña Reclamos).
# Opcional: dejar vacío si solo existe la cuenta MASTER.
PUBLIC_ACCOUNTS=comunicacion:<contraseña-fuerte>:reclamos

# --- Mandame Tu Reclamo (MTR) — proyecto Supabase externo ---
# service_role: bypassa RLS de OTRO proyecto. Server-only, sin prefijo
# NEXT_PUBLIC_. Nunca debe llegar al cliente ni loguearse.
MTR_SUPABASE_URL=https://rzqbrlbamgeacxqwkzxp.supabase.co
MTR_SUPABASE_SERVICE_KEY=<service-role-key-de-mtr>
